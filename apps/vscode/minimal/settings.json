{
  "editor.cursorBlinking": "expand",
  "editor.linkedEditing": true,
  "editor.guides.bracketPairs": true,
  "breadcrumbs.enabled": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "files.autoSave": "onFocusChange",
  "files.autoSaveWhenNoErrors": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "terminal.integrated.stickyScroll.enabled": true,
  "editor.minimap.enabled": false,
  "explorer.fileNesting.enabled": true,
  "workbench.colorTheme": "Tokyo Night",
  "terminal.integrated.env.osx": {},
  "symbols.hidesExplorerArrows": false,
  "console-ninja.featureSet": "Community",
  "editor.fontSize": 16,
  "editor.fontFamily": "'Fira Code', Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.formatOnPaste": true,
  "editor.wrappingIndent": "none",
  "editor.wordWrap": "bounded",
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "git.openRepositoryInParentFolders": "always",
  "debug.javascript.autoAttachFilter": "disabled",
  "security.workspace.trust.untrustedFiles": "open",
  "ts.updateImportsOnFileMove.enabled": "always",
  "workbench.sideBar.location": "right",
  "editor.formatOnSave": true,
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "aws.cloudformation.telemetry.enabled": false,
  "rainbow_csv.autodetect_separators": ["TAB", ",", ";", "|", "~"],
  "explorer.confirmDragAndDrop": false,
  "window.zoomLevel": 1.15,
  "editor.renderWhitespace": "all",
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  "php.validate.executablePath": "C:/xampp/php/php.exe",
  "editor.formatOnType": true,
  "totalTypeScript.hideAllTips": false,
  "totalTypeScript.hideBasicTips": false
}
